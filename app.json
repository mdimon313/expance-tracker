{
  "expo": {
    "name": "Expense Tracker",
    "slug": "expense-tracker",
    "scheme": "expensetracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.expensetracker",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to log in quickly and securely.",
        "NSLocationWhenInUseUsageDescription": "Location helps tag where your transactions happen.",
        "NSPhotoLibraryUsageDescription": "Allow photo access to set your profile picture."
      }
    },
    "android": {
      "package": "com.yourcompany.expensetracker",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Location helps tag where your transactions happen."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./src/assets/notification-icon.png",
          "color": "#10B981"
        }
      ],
      "expo-font",
      "expo-localization"
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
